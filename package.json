    "@quamolit/touch-control": "0.0.13",
    "fontfaceobserver-es": "^3.3.3",
    "hsluv": "^1.0.1",
    "mobile-detect": "^1.4.5",
    "nanoid": "^5.0.6",
    "pixi.js": "7.4.0"
  },
  "devDependencies": {
    "@pixi/filter-drop-shadow": "^5.2.0",
